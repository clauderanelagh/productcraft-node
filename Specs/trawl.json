{
  "components": {
    "schemas": {
      "CreateJobDto": {
        "properties": {
          "description": {
            "description": "Natural-language description of what to extract.",
            "example": "Extract the product title and price from each page.",
            "type": "string"
          },
          "json_schema": {
            "description": "JSON Schema describing the shape of the extraction result. Must be a non-empty object with `type: \"object\"`.",
            "example": {
              "properties": {
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title"
              ],
              "type": "object"
            },
            "type": "object"
          },
          "max_steps": {
            "default": 20,
            "description": "Maximum number of agent steps (one LLM call each) before the job stops. Defaults to 20. Multi-source extractions typically need 40+. The server additionally clamps this to an operator ceiling, so a very large value does not guarantee a very long run — `timeout_s` still applies.",
            "maximum": 1000,
            "minimum": 1,
            "type": "number"
          },
          "model_tier": {
            "description": "Model tier the worker should use (e.g. `standard`, `pro`).",
            "type": "string"
          },
          "suggested_urls": {
            "description": "Seed URLs the worker should start from.",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "timeout_s": {
            "description": "Wall-clock timeout for the job, in seconds.",
            "maximum": 3600,
            "minimum": 1,
            "type": "number"
          },
          "webhook_id": {
            "description": "Webhook id to notify when the job finishes.",
            "type": "string"
          }
        },
        "required": [
          "json_schema",
          "description"
        ],
        "type": "object"
      },
      "CreateWebhookDto": {
        "properties": {
          "active": {
            "description": "Disabled webhooks are never delivered to.",
            "type": "boolean"
          },
          "url": {
            "description": "Destination URL (https required in prod).",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "ErrorResponseDto": {
        "properties": {
          "code": {
            "description": "Stable error code for programmatic handling, when the route sets one.",
            "example": "SERVICE_NOT_ENABLED",
            "type": "string"
          },
          "message": {
            "description": "Human-readable error message. May be a class-validator array on 400.",
            "example": "Policy denies trawl.read on pcft:workspace/7a0c2f7e-2b8d-4f7f-9a51-3f1f0e1f3c11",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "status_code": {
            "description": "HTTP status code echoed in the body.",
            "example": 403,
            "type": "number"
          }
        },
        "required": [
          "status_code",
          "message"
        ],
        "type": "object"
      },
      "JobListPaginationDto": {
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "next_cursor",
          "has_more"
        ],
        "type": "object"
      },
      "JobListResponseDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/JobResponseDto"
            },
            "type": "array"
          },
          "pagination": {
            "$ref": "#/components/schemas/JobListPaginationDto"
          }
        },
        "required": [
          "data",
          "pagination"
        ],
        "type": "object"
      },
      "JobResponseDto": {
        "properties": {
          "attempts": {
            "type": "number"
          },
          "completed_at": {
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enqueued_at": {
            "type": "string"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "json_schema": {
            "type": "object"
          },
          "max_steps": {
            "type": "number"
          },
          "model_tier": {
            "type": "string"
          },
          "result": {
            "nullable": true,
            "type": "object"
          },
          "started_at": {
            "nullable": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          "suggested_urls": {
            "items": {
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          },
          "timeout_s": {
            "type": "number"
          },
          "webhook_id": {
            "nullable": true,
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "status",
          "json_schema",
          "description",
          "suggested_urls",
          "max_steps",
          "timeout_s",
          "model_tier",
          "webhook_id",
          "result",
          "error",
          "attempts",
          "enqueued_at",
          "started_at",
          "completed_at",
          "created_at"
        ],
        "type": "object"
      },
      "TrawlStatsInWindowDto": {
        "properties": {
          "failed": {
            "description": "Of those, jobs that failed.",
            "example": 3,
            "type": "number"
          },
          "jobs": {
            "description": "Jobs created in the window, in any status.",
            "example": 37,
            "type": "number"
          },
          "steps_used": {
            "description": "Steps consumed by the jobs created in the window. Jobs still running, and jobs from before metering, add nothing.",
            "example": 512,
            "type": "number"
          },
          "succeeded": {
            "description": "Of those, jobs that succeeded.",
            "example": 33,
            "type": "number"
          }
        },
        "required": [
          "jobs",
          "succeeded",
          "failed",
          "steps_used"
        ],
        "type": "object"
      },
      "TrawlStatsSeriesDto": {
        "properties": {
          "granularity": {
            "description": "Bucket width.",
            "enum": [
              "day"
            ],
            "example": "day",
            "type": "string"
          },
          "metric": {
            "description": "Jobs created per UTC day in the workspace, in any status.",
            "enum": [
              "jobs"
            ],
            "example": "jobs",
            "type": "string"
          },
          "points": {
            "description": "Dense and zero-filled: one point per UTC day in the window, oldest first, ending today.",
            "items": {
              "$ref": "#/components/schemas/TrawlStatsSeriesPointDto"
            },
            "type": "array"
          }
        },
        "required": [
          "metric",
          "granularity",
          "points"
        ],
        "type": "object"
      },
      "TrawlStatsSeriesPointDto": {
        "properties": {
          "date": {
            "description": "UTC calendar day.",
            "example": "2026-10-07",
            "format": "date",
            "type": "string"
          },
          "value": {
            "description": "Value for that day.",
            "example": 4,
            "type": "number"
          }
        },
        "required": [
          "date",
          "value"
        ],
        "type": "object"
      },
      "TrawlStatsTotalsDto": {
        "properties": {
          "balance_steps": {
            "description": "Remaining Trawl steps: the sum of the credit ledger, the same number `GET /v1/workspaces/{workspaceId}/credits` returns. Zero before the first job; can be slightly negative after the last job of a budget.",
            "example": 8650,
            "type": "number"
          },
          "jobs": {
            "description": "Jobs in the workspace, all time, in any status.",
            "example": 418,
            "type": "number"
          }
        },
        "required": [
          "jobs",
          "balance_steps"
        ],
        "type": "object"
      },
      "TrawlWorkspaceStatsDto": {
        "properties": {
          "generated_at": {
            "description": "When these numbers were computed. Responses are cached for up to 60 seconds.",
            "example": "2026-10-07T09:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "in_window": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrawlStatsInWindowDto"
              }
            ],
            "description": "Counts for the window."
          },
          "last_activity_at": {
            "description": "When the workspace's most recent job was created. Null when there has never been one.",
            "example": "2026-10-07T08:41:12.000Z",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "series": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrawlStatsSeriesDto"
              }
            ],
            "description": "Daily jobs."
          },
          "totals": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrawlStatsTotalsDto"
              }
            ],
            "description": "All-time counts and the credit balance."
          },
          "window": {
            "description": "Window the counts cover.",
            "enum": [
              "1d",
              "7d",
              "30d"
            ],
            "example": "30d",
            "type": "string"
          }
        },
        "required": [
          "window",
          "generated_at",
          "last_activity_at",
          "totals",
          "in_window",
          "series"
        ],
        "type": "object"
      },
      "UpdateWebhookDto": {
        "properties": {
          "active": {
            "description": "Pause/resume the webhook. Setting active=true clears auto-disable.",
            "type": "boolean"
          },
          "url": {
            "description": "New destination URL.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "WebhookCreateResponseDto": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "auto_disabled_at": {
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "failure_count": {
            "type": "number"
          },
          "first_failure_at": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_attempt_at": {
            "nullable": true,
            "type": "string"
          },
          "last_status_code": {
            "nullable": true,
            "type": "number"
          },
          "signing_secret": {
            "description": "Plaintext signing secret returned EXACTLY ONCE on create + rotate. Persist immediately — it never appears on subsequent GETs.",
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "url",
          "active",
          "failure_count",
          "last_status_code",
          "last_attempt_at",
          "auto_disabled_at",
          "first_failure_at",
          "created_at",
          "signing_secret"
        ],
        "type": "object"
      },
      "WebhookDeliveryListResponseDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/WebhookDeliveryResponseDto"
            },
            "type": "array"
          },
          "pagination": {
            "$ref": "#/components/schemas/WebhookListPaginationDto"
          }
        },
        "required": [
          "data",
          "pagination"
        ],
        "type": "object"
      },
      "WebhookDeliveryResponseDto": {
        "properties": {
          "attempt_number": {
            "type": "number"
          },
          "attempted_at": {
            "type": "string"
          },
          "error_message": {
            "nullable": true,
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "latency_ms": {
            "nullable": true,
            "type": "number"
          },
          "response_body_truncated": {
            "nullable": true,
            "type": "string"
          },
          "status_code": {
            "description": "HTTP status returned by the destination; null when no response was received.",
            "nullable": true,
            "type": "number"
          },
          "webhook_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "webhook_id",
          "job_id",
          "event_id",
          "event_type",
          "attempt_number",
          "status_code",
          "response_body_truncated",
          "error_message",
          "latency_ms",
          "attempted_at"
        ],
        "type": "object"
      },
      "WebhookListPaginationDto": {
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "next_cursor",
          "has_more"
        ],
        "type": "object"
      },
      "WebhookListResponseDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/WebhookResponseDto"
            },
            "type": "array"
          },
          "pagination": {
            "$ref": "#/components/schemas/WebhookListPaginationDto"
          }
        },
        "required": [
          "data",
          "pagination"
        ],
        "type": "object"
      },
      "WebhookResponseDto": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "auto_disabled_at": {
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "failure_count": {
            "type": "number"
          },
          "first_failure_at": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_attempt_at": {
            "nullable": true,
            "type": "string"
          },
          "last_status_code": {
            "nullable": true,
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "url",
          "active",
          "failure_count",
          "last_status_code",
          "last_attempt_at",
          "auto_disabled_at",
          "first_failure_at",
          "created_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Trawl service for the ProductCraft platform",
    "title": "Trawl API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/v1/workspaces/{workspace_id}/credits": {
      "get": {
        "operationId": "CreditsController_get",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Balance and recent entries."
          },
          "403": {
            "description": "Caller lacks `trawl.read`, or the service is not enabled."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Remaining Trawl steps for this workspace, with recent ledger entries",
        "tags": [
          "credits"
        ]
      }
    },
    "/v1/workspaces/{workspace_id}/jobs": {
      "get": {
        "operationId": "JobController_list",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by job status.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "queued",
                "running",
                "succeeded",
                "failed",
                "cancelled"
              ],
              "type": "string"
            }
          },
          {
            "description": "Opaque cursor for pagination.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobListResponseDto"
                }
              }
            },
            "description": "Page of jobs with pagination cursor."
          },
          "403": {
            "description": "Caller lacks `trawl.list`, or workspace has not enabled the `trawl` service."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List trawl jobs (paginated, newest first)",
        "tags": [
          "jobs"
        ]
      },
      "post": {
        "operationId": "JobController_create",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Pass a key (1..256 chars, [A-Za-z0-9_\\-:]) to make retries safe — replays return the original response for 24h.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponseDto"
                }
              }
            },
            "description": "Job created and queued."
          },
          "400": {
            "description": "Invalid JSON Schema (must be a non-empty `type: object`)."
          },
          "403": {
            "description": "Caller lacks `trawl.create`, or workspace has not enabled the `trawl` service."
          },
          "429": {
            "description": "Rate limited. `RATE_LIMITED` — submission window exceeded (default 10/min per workspace); the `Retry-After` header gives the seconds until the window resets. `TOO_MANY_ACTIVE_JOBS` — too many queued/running jobs (default 25); retry once some finish."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create (enqueue) a trawl job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/workspaces/{workspace_id}/jobs/{id}": {
      "get": {
        "operationId": "JobController_get",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponseDto"
                }
              }
            },
            "description": "Job row."
          },
          "404": {
            "description": "Job not found in this workspace."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a single trawl job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/workspaces/{workspace_id}/jobs/{id}/cancel": {
      "post": {
        "operationId": "JobController_cancel",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponseDto"
                }
              }
            },
            "description": "Job cancelled."
          },
          "404": {
            "description": "Job not found in this workspace."
          },
          "422": {
            "description": "Job is already in a terminal state and cannot be cancelled."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cancel a queued or running trawl job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/workspaces/{workspace_id}/stats": {
      "get": {
        "description": "Total jobs, jobs created / succeeded / failed and steps used in the window, the credit balance, when the latest job was created and a daily jobs series.\n\n**Active** means a job was created.\n\nDays are UTC. Counts only: no target URLs, descriptions or job results. Cached for up to 60 seconds (`generated_at`).",
        "operationId": "WorkspaceStatsController_get",
        "parameters": [
          {
            "description": "Workspace id.",
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Window for `in_window` and the length of `series`, in UTC days ending today.",
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "default": "30d",
              "enum": [
                "1d",
                "7d",
                "30d"
              ],
              "example": "30d",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrawlWorkspaceStatsDto"
                }
              }
            },
            "description": "Trawl stats."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "`window` is not one of 1d, 7d, 30d."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Caller lacks `trawl.read` on the workspace, or Trawl is not enabled on it (`SERVICE_NOT_ENABLED`)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
