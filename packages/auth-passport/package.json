{
  "name": "@productcraft/auth-passport",
  "version": "2.1.0",
  "description": "Passport-JWT adapter for ProductCraft Auth. Plug an Auth ConsumerScope into a `passport-jwt` Strategy so existing Passport setups can authenticate Auth-issued tokens.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run"
  },
  "keywords": [
    "productcraft",
    "sdk",
    "auth",
    "passport",
    "passport-jwt",
    "jwt"
  ],
  "author": "ProductCraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauderanelagh/productcraft-node.git",
    "directory": "packages/auth-passport"
  },
  "homepage": "https://productcraft.co/docs/auth",
  "bugs": {
    "url": "https://github.com/clauderanelagh/productcraft-node/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "peerDependencies": {
    "@productcraft/auth": "^1.1.0",
    "passport-jwt": "^4.0.0"
  },
  "devDependencies": {
    "@productcraft/auth": "workspace:*"
  }
}
