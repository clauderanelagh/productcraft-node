{
  "name": "@productcraft/flags",
  "version": "0.2.0",
  "description": "Feature flags and remote settings for Node.js, browsers and React Native (ProductCraft Flags): FlagsClient downloads one config per environment and evaluates flags locally, so user attributes never leave your app; plus the generated management client for projects, flags, targeting, segments and SDK keys. A key used in a browser or mobile app makes its whole config public.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/browser/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/browser/index.cjs"
        }
      },
      "react-native": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/browser/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/browser/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "browser": {
        "import": {
          "types": "./dist/testing.d.ts",
          "default": "./dist/browser/testing.js"
        },
        "require": {
          "types": "./dist/testing.d.cts",
          "default": "./dist/browser/testing.cjs"
        }
      },
      "react-native": {
        "import": {
          "types": "./dist/testing.d.ts",
          "default": "./dist/browser/testing.js"
        },
        "require": {
          "types": "./dist/testing.d.cts",
          "default": "./dist/browser/testing.cjs"
        }
      },
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./manifest.json": "./manifest.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  },
  "files": [
    "dist/**",
    "manifest.json",
    "api.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node -e \"require('node:fs').copyFileSync('src/_generated/manifest.json','manifest.json')\"",
    "test": "tsc -p tests/tsconfig.json && vitest run"
  },
  "keywords": [
    "productcraft",
    "sdk",
    "feature-flags",
    "feature-toggles",
    "remote-config",
    "configcat-alternative"
  ],
  "author": "ProductCraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauderanelagh/productcraft-node.git",
    "directory": "packages/flags"
  },
  "homepage": "https://productcraft.co/docs/flags",
  "bugs": {
    "url": "https://github.com/clauderanelagh/productcraft-node/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@productcraft/core": "workspace:^",
    "@productcraft/flags-engine": "workspace:^",
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "jsdom": "31.0.0"
  }
}
