          "response": {
            "status": 200,
            "headers": {
              "etag": "W/\"aaa\"",
              "x-pc-config-revision": "3",
              "x-pc-config-generation": "1"
            },
            "body": {
              "schema": 1,
              "revision": 3,
              "generation": 1,
              "published_at": "2026-11-08T14:02:11Z",
              "config_id": "11111111-1111-4111-8111-111111111111",
              "environment_id": "22222222-2222-4222-8222-222222222222",
              "salt": "c2FsdC1mb3ItdmVjdG9ycw",
              "delivery": {
                "base_urls": [
                  "https://api.flags.productcraft.co"
                ],
                "mode": "hint"
              },
              "segments": {},
              "settings": {
                "flag": {
                  "type": "boolean",
                  "value": true
                }
              }
            }
          },
          "expect": {
            "held": {
              "revision": 3,
              "generation": 1
            },
            "accepted": true
