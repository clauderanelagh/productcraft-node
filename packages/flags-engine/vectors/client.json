        },
        {
          "request": {
            "if_none_match": "W/\"aaa\""
          },
          "response": {
            "status": 304,
            "headers": {
              "etag": "W/\"aaa\""
            }
          },
          "expect": {
            "held": {
              "revision": 3,
              "generation": 1
            },
            "accepted": false
          }
        }
      ]
