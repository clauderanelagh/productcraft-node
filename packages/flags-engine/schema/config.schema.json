{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productcraft.co/docs/flags/config-json/schema-1.json",
  "title": "ProductCraft Flags config JSON, schema 1",
  "description": "The body of GET /v1/configs/{sdk_key}/config.json: one config in one environment, evaluated locally by the SDK. Unknown fields are ignored. Rules the schema cannot express (percentages add up to 100, comparator arity and value types, segment references) are in SPEC.md and enforced by parseConfig in @productcraft/flags-engine.",
  "type": "object",
  "required": ["schema", "revision", "generation", "salt", "settings"],
  "properties": {
    "schema": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Monotonic per (config, environment) within a generation." },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Bumped only after a database restore; a different generation resets the SDK's revision guard." },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "config_id": { "type": ["string", "null"] },
    "environment_id": { "type": ["string", "null"] },
    "salt": { "type": "string", "description": "Per project, base64url; appended to values hashed for confidential comparators." },
    "delivery": {
      "type": ["object", "null"],
      "properties": {
        "base_urls": { "type": "array", "items": { "type": "string" }, "description": "A hint. SDKs keep only https://*.productcraft.co origins with no userinfo, port or path." },
        "mode": { "type": "string" }
      }
    },
    "segments": { "type": "object", "additionalProperties": { "$ref": "#/$defs/segment" } },
    "settings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/setting" } }
  },
  "$defs": {
    "value": { "type": ["boolean", "string", "number"] },
    "setting": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["boolean", "string", "integer", "number", "json"] },
        "value": { "$ref": "#/$defs/value" },
        "seed": { "type": ["string", "null"], "description": "Frozen hashing seed; omitted when equal to the key." },
        "percentage_attribute": { "type": ["string", "null"], "minLength": 1, "description": "Omitted when \"identifier\"." },
        "rules": { "type": ["array", "null"], "items": { "$ref": "#/$defs/rule" } },
        "percentages": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/percentages" }] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "value": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "enum": ["string", "json"] } } }, "then": { "properties": { "value": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "integer" } } }, "then": { "properties": { "value": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 } } } },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "value": { "type": "number" } } } }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["conditions"],
      "properties": {
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "serve": { "$ref": "#/$defs/value" },
        "percentages": { "$ref": "#/$defs/percentages" }
      },
      "oneOf": [{ "required": ["serve"] }, { "required": ["percentages"] }]
    },
    "percentages": {
      "type": "array",
      "minItems": 1,
      "description": "Percentages are integers that add up to 100.",
      "items": {
        "type": "object",
        "required": ["percentage", "value"],
        "properties": { "percentage": { "type": "integer", "minimum": 0, "maximum": 100 }, "value": { "$ref": "#/$defs/value" } }
      }
    },
    "condition": {
      "type": "object",
      "oneOf": [
        { "required": ["user"], "properties": { "user": { "$ref": "#/$defs/userCondition" } } },
        {
          "required": ["segment"],
          "properties": {
            "segment": {
              "type": "object",
              "required": ["segment", "comparator"],
              "properties": { "segment": { "type": "string" }, "comparator": { "type": "string", "description": "in or not_in" } }
            }
          }
        },
        {
          "required": ["prerequisite"],
          "properties": {
            "prerequisite": {
              "type": "object",
              "required": ["setting", "comparator", "value"],
              "properties": { "setting": { "type": "string" }, "comparator": { "type": "string", "description": "eq or neq" }, "value": { "$ref": "#/$defs/value" } }
            }
          }
        }
      ]
    },
    "userCondition": {
      "type": "object",
      "required": ["attribute", "comparator", "values"],
      "properties": {
        "attribute": { "type": "string", "minLength": 1 },
        "comparator": { "type": "string", "description": "See SPEC.md section 4. An unknown comparator is a soft miss, so new comparators are additive." },
        "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } }
      }
    },
    "segment": {
      "type": "object",
      "required": ["conditions"],
      "properties": {
        "seed": { "type": ["string", "null"], "description": "Frozen hashing context; omitted when equal to the key." },
        "conditions": { "type": "array", "items": { "type": "object", "required": ["user"], "properties": { "user": { "$ref": "#/$defs/userCondition" } } } }
      }
    }
  }
}
