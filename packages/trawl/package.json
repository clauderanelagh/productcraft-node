{
  "name": "@productcraft/trawl",
  "version": "1.0.4",
  "description": "AI web extraction: send a JSON Schema and a description, get schema-shaped data extracted from the live web (ProductCraft Trawl). Resources, polling, typed errors, retries and webhook verification, generated from the production OpenAPI spec.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./manifest.json": "./manifest.json"
  },
  "files": [
    "dist/**",
    "manifest.json",
    "api.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').copyFileSync('src/_generated/manifest.json','manifest.json')\"",
    "test": "tsc -p tests/tsconfig.json && vitest run"
  },
  "keywords": [
    "productcraft",
    "sdk",
    "trawl",
    "web-extraction",
    "scraping"
  ],
  "author": "ProductCraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauderanelagh/productcraft-node.git",
    "directory": "packages/trawl"
  },
  "homepage": "https://productcraft.co/docs/trawl",
  "bugs": {
    "url": "https://github.com/clauderanelagh/productcraft-node/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@productcraft/core": "workspace:^",
    "openapi-fetch": "^0.13.0"
  }
}
