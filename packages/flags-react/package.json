{
  "name": "@productcraft/flags-react",
  "version": "0.0.0",
  "description": "React bindings for ProductCraft Flags: FlagsProvider, useFlag and SSR bootstrap (Next.js App and Pages Router) over FlagsClient's local evaluation. A key used in a browser or mobile app makes its whole config public, so client flags belong in their own config with no internal rules.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "tsc -p tests/tsconfig.json && vitest run"
  },
  "keywords": [
    "productcraft",
    "sdk",
    "react",
    "nextjs",
    "feature-flags",
    "feature-toggles",
    "remote-config"
  ],
  "author": "ProductCraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauderanelagh/productcraft-node.git",
    "directory": "packages/flags-react"
  },
  "homepage": "https://productcraft.co/docs/flags",
  "bugs": {
    "url": "https://github.com/clauderanelagh/productcraft-node/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@productcraft/flags": "^0.1.0 || ^0.2.0 || ^1.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@productcraft/flags": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
