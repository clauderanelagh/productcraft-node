{
  "name": "@productcraft/gen-fixture",
  "version": "0.0.1",
  "private": true,
  "description": "Test fixture for scripts/gen-sdk.mjs: a package generated from fixture.openapi.json. Never published.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsc -p tests/tsconfig.json && vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@productcraft/core": "workspace:^",
    "openapi-fetch": "^0.13.0"
  }
}
